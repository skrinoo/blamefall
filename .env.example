# ─────────────────────────────────────────────────────────────
# 《锅从天降》服务端环境变量模板
#
# 用法：复制成 .env.local 后填真值（本地），或直接填进部署平台的环境变量面板（生产）。
#   copy .env.example .env.local        # Windows PowerShell
#   cp .env.example .env.local          # macOS / Linux
#
# .gitignore 已忽略 .env 与 .env.*，并对 .env.example 开了例外 ——
# 本文件只有变量名和空值，不含任何真实密钥，必须提交。
#
# ⚠️ 填了真值之后绝对不要 git add。提交前扫一眼：
#       git diff --cached | Select-String -Pattern 'sk-'
# ─────────────────────────────────────────────────────────────

# OpenAI 兼容网关的地址，到 /v1 为止（不要带 /chat/completions，代码会自己拼）。
# 必填。缺失时 /api/judge 返回 503，游戏自动切本地兜底引擎，玩家侧无感。
BLAMEFALL_API_BASE=

# 网关密钥。必填。只出现在部署平台的环境变量里，不出现在仓库任何文件中。
BLAMEFALL_API_KEY=

# 模型名。默认 gemini-2.5-flash —— 实测 525 completion_tokens 出完整结果。
# ⚠️ 禁用一切思考型模型：step-3.7-flash 实测烧掉 4409 completion_tokens，
#    正式回答却是空的（只回吐思维链），端点会返回 502 empty_content。
BLAMEFALL_MODEL=gemini-2.5-flash

# 裁判用 0.85。批量生成判定库用 0.92（scripts/generate-verdicts.ps1）。
# 两个数字不一样是有意的：裁判要稳，文案要野。
BLAMEFALL_TEMPERATURE=0.85

# 0 在实测网关上表示「不限制」。
# 若换成严格的 OpenAI 兼容实现，0 会被当成「不许输出任何 token」，届时改成 600。
BLAMEFALL_MAX_TOKENS=0

# 上游超时兜底（毫秒）。客户端 1350ms 就会放弃，这个值只用于防止函数
# 在上游卡死时无限挂着。改它请同时检查 api/health.mjs 的 maxDuration 是否还够用。
BLAMEFALL_UPSTREAM_TIMEOUT=6000

# 可选。填了之后只接受来自这些 Origin / Referer 的浏览器请求，多个用逗号分隔：
#   BLAMEFALL_ALLOW_ORIGIN=https://blamefall-yy3a.vercel.app,http://localhost:3000
#
# ⚠️ 这**不是安全边界** —— Origin 头可以被非浏览器客户端伪造。
# 它挡住的只是互联网上无脑扫公开端点的脚本，那批脚本恰好是
# 「演示链接挂三天就被刷爆 token 余额」的主要来源。
#
# 留空 = 不校验。这样 curl 掐表、评委手动试都不会被挡住。
BLAMEFALL_ALLOW_ORIGIN=
